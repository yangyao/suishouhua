<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ===== 配对页 ===== -->
    <LinearLayout
        android:id="@+id/pairingScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_warm_white"
        android:orientation="horizontal"
        android:padding="48dp"
        android:gravity="center_vertical">

        <!-- 左侧：标题与提示 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="手机画，电视看"
                android:textColor="@color/text_graphite"
                android:textSize="52sp"
                android:textStyle="bold" />

            <!-- 三步提示 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout style="@style/StepItem">
                    <TextView style="@style/StepIcon" android:text="✎" />
                    <TextView style="@style/StepLabel" android:text="打开手机应用" />
                </LinearLayout>

                <TextView style="@style/StepDot" />

                <LinearLayout style="@style/StepItem">
                    <TextView style="@style/StepIcon" android:text="▣" />
                    <TextView style="@style/StepLabel" android:text="扫描二维码" />
                </LinearLayout>

                <TextView style="@style/StepDot" />

                <LinearLayout style="@style/StepItem">
                    <TextView style="@style/StepIcon" android:text="〜" />
                    <TextView style="@style/StepLabel" android:text="开始绘图" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:text="每次仅连接一部手机"
                android:textColor="@color/text_secondary"
                android:textSize="20sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 分隔线 -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/divider" />

        <!-- 右侧：二维码与状态胶囊 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginStart="40dp">

            <ImageView
                android:id="@+id/qrImage"
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:contentDescription="配对二维码"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/waitingPill"
                android:layout_width="wrap_content"
                android:layout_height="64dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/pill_blue"
                android:gravity="center"
                android:paddingStart="48dp"
                android:paddingEnd="48dp"
                android:text="等待连接"
                android:textColor="@color/accent_blue"
                android:textSize="24sp"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== 同步画板 ===== -->
    <FrameLayout
        android:id="@+id/canvasScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <com.suishouhua.tv.render.CanvasView
            android:id="@+id/canvasView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 右上角连接状态 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/green_dot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="已连接 iPhone"
                android:textColor="@color/text_graphite"
                android:textSize="26sp" />
        </LinearLayout>

        <!-- 右下角提示 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="32dp"
            android:text="返回键 · 断开连接"
            android:textColor="@color/text_secondary"
            android:textSize="22sp" />
    </FrameLayout>
</FrameLayout>
